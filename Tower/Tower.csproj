<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net9.0</TargetFramework>
        <RollForward>Major</RollForward>
        <PublishReadyToRun>false</PublishReadyToRun>
        <TieredCompilation>false</TieredCompilation>
    </PropertyGroup>
    <PropertyGroup>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <ApplicationIcon>Icon.ico</ApplicationIcon>
    </PropertyGroup>
    <ItemGroup>
        <None Remove="Icon.ico"/>
        <None Remove="Icon.bmp"/>
    </ItemGroup>
    <ItemGroup>
        <EmbeddedResource Include="Icon.ico"/>
        <EmbeddedResource Include="Icon.bmp"/>
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="MonoGame.Extended" Version="5.3.1" />
        <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.4.1" />
        <PackageReference Include="MonoGame.Content.Builder.Task" Version="3.8.4.1" />
        <PackageReference Include="Myra" Version="1.5.9" />
    </ItemGroup>
    <ItemGroup>
      <Folder Include="Src\Observers\" />
    </ItemGroup>
    <ItemGroup>
      <Compile Update="Src\Core\BasicEnemy_Scripts.cs">
        <DependentUpon>BasicEnemy.cs</DependentUpon>
      </Compile>
      <Compile Update="Src\Core\BasicTower_Scripts.cs">
        <DependentUpon>BasicTower.cs</DependentUpon>
      </Compile>
      <Compile Update="Src\Core\Citadel_Scripts.cs">
        <DependentUpon>Citadel.cs</DependentUpon>
      </Compile>
      <Compile Update="Src\Core\OrbProjectile_Scripts.cs">
        <DependentUpon>OrbProjectile.cs</DependentUpon>
      </Compile>
    </ItemGroup>
    <Target Name="RestoreDotnetTools" BeforeTargets="Restore">
        <Message Text="Restoring dotnet tools" Importance="High"/>
        <Exec Command="dotnet tool restore"/>
    </Target>
</Project>